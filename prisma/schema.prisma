// Generated Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COACH
  TRAINEE
}

model User {
  id        Int      @id @default(autoincrement())
  phone     String
  name      String
  role      Role
  password  String?
  coach     Coach?
  trainee   Trainee?
  createdAt DateTime @default(now())
  updatedAt DateTime

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("refresh_tokens")
}

model Coach {
  userId                  Int                   @id @map("user_id")
  experience              String
  bio                     String
  user                    User                  @relation(fields: [userId], references: [id])
  trainingPlans           TrainingPlan[]
  trainees                Trainee[]
  coachSubscriptionPlanId Int                   @map("coach_subscription_plan_id")
  coachSubscriptionPlan   CoachSubscriptionPlan @relation(fields: [coachSubscriptionPlanId], references: [id])
  createdAt               DateTime              @default(now())
  updatedAt               DateTime

  @@map("coaches")
}

model Trainee {
  userId       Int           @id @map("user_id")
  gender       String
  birthDate    DateTime      @map("birth_date")
  bodyMetrics  Json          @map("body_metrics")
  coachId      Int           @map("coach_id")
  user         User          @relation(fields: [userId], references: [id])
  coach        Coach         @relation(fields: [coachId], references: [userId])
  trainingPlan TrainingPlan?
  workoutLogs  WorkoutLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime

  @@map("trainees")
}

model CoachSubscriptionPlan {
  id            Int      @id @default(autoincrement())
  name          String
  maxTrainees   Int      @map("max_trainees")
  price         Decimal
  billingPeriod String   @map("billing_period")
  coaches       Coach[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@map("coach_subscription_plans")
}

model Exercise {
  id               Int               @id @default(autoincrement())
  name             String
  description      String
  difficulty       String
  equipment        String
  illustration     String[]
  workoutExercises WorkoutExercise[]
  exerciseMuscles  ExerciseMuscle[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime

  @@map("exercises")
}

model ExerciseMuscle {
  exerciseId Int      @id @map("exercise_id")
  name       String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@map("exercise_muscles")
}

enum TrainingPlanStatus {
  IDLE
  ACTIVE
  COMPLETED
}

model TrainingPlan {
  id          Int                @id @default(autoincrement())
  name        String
  description String
  status      TrainingPlanStatus
  coachId     Int                @map("coach_id")
  traineeId   Int                @unique @map("trainee_id")
  duration    Int
  isFav       Boolean            @map("is_fav")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime
  coach       Coach              @relation(fields: [coachId], references: [userId])
  trainee     Trainee            @relation(fields: [traineeId], references: [userId])
  workouts    Workout[]

  @@map("training_plans")
}

model Workout {
  id               Int               @id @default(autoincrement())
  name             String
  order            Int
  duration         Int
  planId           Int               @map("plan_id")
  trainingPlan     TrainingPlan      @relation(fields: [planId], references: [id])
  workoutExercises WorkoutExercise[]
  workoutLog       WorkoutLog?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime

  @@map("workouts")
}

model WorkoutExercise {
  exerciseId  Int          @map("exercise_id")
  workoutId   Int          @map("workout_id")
  order       Int
  reps        String
  sets        Int
  restTime    Int          @map("rest_time")
  duration    Int
  weight      Decimal
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  workout     Workout      @relation(fields: [workoutId], references: [id])
  exercise    Exercise     @relation(fields: [exerciseId], references: [id])
  exerciseLog ExerciseLog?

  @@id([exerciseId, workoutId])
  @@map("workout_exercises")
}

model WorkoutLog {
  id           Int           @id @default(autoincrement())
  notes        String
  workoutId    Int           @unique @map("workout_id")
  traineeId    Int           @map("trainee_id")
  createdAt    DateTime      @default(now()) // createdAt == startTime
  updatedAt    DateTime
  end          DateTime
  trainee      Trainee       @relation(fields: [traineeId], references: [userId])
  workout      Workout       @relation(fields: [workoutId], references: [id])
  exerciseLogs ExerciseLog[]

  @@map("workout_logs")
}

model ExerciseLog {
  id              Int             @id @default(autoincrement())
  order           Int
  status          String
  exerciseId      Int             @map("exercise_id")
  workoutId       Int             @map("workout_id")
  workoutLogId    Int             @map("workout_log_id")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  workoutLog      WorkoutLog      @relation(fields: [workoutLogId], references: [id])
  workoutExercise WorkoutExercise @relation(fields: [workoutId, exerciseId], references: [workoutId, exerciseId])
  setLogs         SetLog[]

  @@unique([workoutId, exerciseId])
  @@map("exercise_logs")
}

model SetLog {
  id            Int         @id @default(autoincrement())
  reps          String
  weight        Decimal
  exerciseLogId Int         @map("exercise_log_id")
  exerciseLog   ExerciseLog @relation(fields: [exerciseLogId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime

  @@map("set_logs")
}
